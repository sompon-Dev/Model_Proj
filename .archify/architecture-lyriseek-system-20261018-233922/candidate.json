  "cards": [
    { "dot": "amber", "title": "Two parallel backends", "items": ["Backend_Database (port 8000) owns all relational data", "Ver.5 Search API (port 8002) only holds the embedding index — it never queries Postgres directly"] },
    { "dot": "cyan", "title": "Closing the ID gap", "items": ["Ver.5 search results carry only song_name/artist text", "The app calls /Song/by_names afterwards to recover the real song_id and youtube_link"] },
    { "dot": "emerald", "title": "Incremental re-indexing", "items": ["UpdateModel.js lets an admin pick Train_Song rows to train", "BuildindexUpdate.py re-uses the frozen E5 model and only encodes the new chunks, then appends to the existing tensor"] },
    { "dot": "rose", "title": "Offline / manual tools", "items": ["FetchThumbnails.py and BuildindexUpdate.py are run by hand, not triggered by a schedule", "Both write straight into Postgres/the index files, bypassing the REST API"] },
    { "dot": "violet", "title": "Key source files (unverified — uncommitted working tree)", "items": ["Homeuser.js, Result.js, Login.js, Otp.js, lib/supabase.js (Frontend_Ver_2/frontend_Ver2/src, /lib)", "main.py (Backend_Database); API.py, Search.py, BuildindexUpdate.py (Ver.5)", "FetchThumbnails.py (imageFetching)"] }
